APP_NAME="Gestor de Proyectos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# -----------------------------------------------------------------------
# Correo transaccional vía Brevo API (sin SMTP).
# DigitalOcean bloquea los puertos 465/587; usamos la API HTTPS de Brevo.
# Obtén tu API key en: https://app.brevo.com/ → Settings → API Keys
# En local puedes usar MAIL_MAILER=log para ver el correo en storage/logs/laravel.log
# -----------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="soporte@scrumter.io"
MAIL_FROM_NAME="Scrumter"

# -----------------------------------------------------------------------
# Brevo (ex Sendinblue) — API key para envío de correos transaccionales
# Crea tu cuenta en https://www.brevo.com/ y genera una API key en:
#   Settings > API Keys > Generate a new API key
# -----------------------------------------------------------------------
BREVO_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# Firebase Backend (Admin SDK) — apunta al JSON de cuenta de servicio
# El archivo NO debe subirse al repositorio (ver .gitignore)
# -----------------------------------------------------------------------
FIREBASE_CREDENTIALS=storage/firebase/service-account.json

# -----------------------------------------------------------------------
# Firebase Frontend (Web SDK) — valores públicos del firebaseConfig
# -----------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------
# AI Assistant Backend Providers
# -----------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# -----------------------------------------------------------------------
# Wompi Colombia — Pasarela de pagos
# Obtén tus claves en: https://comercios.wompi.co/
# -----------------------------------------------------------------------
PAYMENT_PROVIDER=wompi
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CURRENCY=COP
